{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/notion(.*)", "dest": "/api/notion.js" },
    { "src": "/api/anthropic(.*)", "dest": "/api/anthropic.js" },
    { "src": "/api/telegram(.*)", "dest": "/api/telegram.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
